# Salin file ini jadi .env.local (jangan commit .env.local ke git)

# true  = frontend jalan sendiri pakai data mock (default sekarang)
# false = semua request beneran ke backend di NEXT_PUBLIC_API_URL
NEXT_PUBLIC_USE_MOCK=false

# Base URL backend Express temanmu. Cuma dipakai kalau USE_MOCK=false.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
